# gwx runtime configuration.
# Copy to .env; it is auto-loaded on startup during local development.
# In production, set these variables in the process environment instead.

APP_ENV=development
HTTP_ADDR=:8090
DATABASE_URL=postgres://postgres:password@localhost:5433/gwx?sslmode=disable

# --- Universe configuration (applied/upserted on every server start) ---------
# This is the "manual config on server start" knob: change these, restart, done.
UNIVERSE_CODE=universe_gwx_1
UNIVERSE_NAME=Classic Universe
# Global multipliers (two modifiers, as in GalaxyWars).
# GAME_SPEED scales build time, research time AND resource production (higher = faster).
# FLEET_SPEED scales fleet travel time (higher = faster).
GAME_SPEED=1
FLEET_SPEED=1
MAX_GALAXIES=3
MAX_SYSTEMS=199
# Building construction queue slots per planet (reference: 6).
BUILD_QUEUE_SLOTS=6
# Research queue slots per account (reference: 4).
RESEARCH_QUEUE_SLOTS=4
# Optional seasonal round end (RFC3339). Empty = long-term universe.
# Example: 2027-01-01T00:00:00Z
ENDS_AT=
# Self-playing NPC accounts. The server tops the universe up to this many on
# start (it never removes any). 0 = NPCs disabled.
NPC_COUNT=0
# How many NPCs one scheduler tick may let think (default 25). Raise it for a
# large NPC population; the server warns on start if this looks too small.
NPC_BATCH=25
# Opt-in NPC offense: scout a target with a probe, read the report and attack
# when favorable. 0 (default) = defensive-only brain. Set 1 to enable.
NPC_RAID=0
# Multiplier on the profile's per-decision scout probability, in (0,1].
NPC_RAID_CHANCE=0.15
# Maximum ATTACK fleets an NPC brain may launch per scheduler tick.
NPC_RAID_MAX=5

# --- Colony Builder (automatic, template-driven construction) ----------------
# How many Colony Builder accounts one scheduler tick may drive (default 25).
# Raise it for a large player base; the phase is cadence-limited below.
BUILDER_BATCH=25
# How often each enabled account is re-checked, in seconds (default 30).
BUILDER_INTERVAL_SECONDS=30
