# gwx runtime configuration.
# Copy to .env; it is auto-loaded on startup during local development.
# In production, set these variables in the process environment instead.

APP_ENV=development
HTTP_ADDR=:8090
DATABASE_URL=postgres://postgres:password@localhost:5433/gwx?sslmode=disable

# --- Universe configuration (applied/upserted on every server start) ---------
# This is the "manual config on server start" knob: change these, restart, done.
UNIVERSE_CODE=universe_gwx_1
UNIVERSE_NAME=Classic Universe
# Global multipliers (two modifiers, as in GalaxyWars).
# GAME_SPEED scales build time, research time AND resource production (higher = faster).
# FLEET_SPEED scales fleet travel time (higher = faster).
GAME_SPEED=1
FLEET_SPEED=1
MAX_GALAXIES=3
MAX_SYSTEMS=199
# Building construction queue slots per planet (reference: 6).
BUILD_QUEUE_SLOTS=6
# Optional seasonal round end (RFC3339). Empty = long-term universe.
# Example: 2027-01-01T00:00:00Z
ENDS_AT=
